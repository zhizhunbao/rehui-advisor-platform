# Database Configuration
# 数据库模式：local | supabase | 空（自动：dev=local, prod=supabase）
DB_MODE=

# 本地 PostgreSQL (Docker)
DATABASE_URL=postgresql://postgres:password@localhost:5432/rehui_advisor

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_DB_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Application Configuration
ENV=development
PORT=8000
API_PREFIX=/api
DEBUG=true

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# LLM Providers (至少配置一个)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# GitHub API (可选，用于提高 API 限制)
# 无 Token: 60 requests/hour
# 有 Token: 5000 requests/hour
# 获取: https://github.com/settings/tokens (无需任何权限)
GITHUB_TOKEN=
