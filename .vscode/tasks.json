{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 启动后端服务 (端口8000)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& $env:USERPROFILE\\.local\\bin\\uv.exe run uvicorn src.main:app --reload --port 8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "backend"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "isBackground": true
    },
    {
      "label": "🎨 启动前端服务 (端口3000)",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-Command", "npm run dev"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "frontend"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "isBackground": true
    },
    {
      "label": "🌟 启动全栈开发环境",
      "dependsOrder": "parallel",
      "dependsOn": ["🚀 启动后端服务 (端口8000)", "🎨 启动前端服务 (端口3000)"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "📦 构建前端",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "options": {
        "cwd": "${workspaceFolder}/frontend",
        "shell": {
          "executable": "cmd.exe",
          "args": ["/c"]
        }
      },
      "problemMatcher": ["$tsc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "build"
      },
      "group": "build"
    },
    {
      "label": "🔍 后端代码检查 (Python)",
      "type": "shell",
      "command": "uv",
      "args": ["run", "ruff", "check", "src"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "lint"
      }
    },
    {
      "label": "🔎 前端代码检查",
      "type": "shell",
      "command": "npm",
      "args": ["run", "lint"],
      "options": {
        "cwd": "${workspaceFolder}/frontend",
        "shell": {
          "executable": "cmd.exe",
          "args": ["/c"]
        }
      },
      "problemMatcher": ["$eslint-stylish"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "lint"
      }
    },
    {
      "label": "🔧 后端自动修复代码 (Python)",
      "type": "shell",
      "command": "uv",
      "args": ["run", "ruff", "check", "--fix", "src"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "✨ 后端格式化代码 (Python)",
      "type": "shell",
      "command": "uv",
      "args": ["run", "ruff", "format", "src"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🧪 后端运行测试 (Python)",
      "type": "shell",
      "command": "uv",
      "args": ["run", "pytest", "-v"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "test"
      },
      "group": "test"
    },
    {
      "label": "🔄 后端监听测试 (Python)",
      "type": "shell",
      "command": "uv",
      "args": ["run", "pytest-watch"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": "test",
      "isBackground": true
    },
    {
      "label": "🔄 数据库迁移 (Alembic)",
      "type": "shell",
      "command": "uv",
      "args": ["run", "alembic", "upgrade", "head"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "📝 生成数据库迁移 (Alembic)",
      "type": "shell",
      "command": "uv",
      "args": ["run", "alembic", "revision", "--autogenerate", "-m", "auto"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🧹 清理依赖",
      "type": "shell",
      "command": "rmdir /s /q frontend\\node_modules",
      "windows": {
        "command": "rmdir /s /q frontend\\node_modules"
      },
      "linux": {
        "command": "rm -rf frontend/node_modules"
      },
      "osx": {
        "command": "rm -rf frontend/node_modules"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🐳 启动数据库服务",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "docker/scripts/dev-up.ps1"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🛑 停止数据库服务",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "docker/scripts/dev-down.ps1"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🔄 重启数据库服务",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "docker/scripts/dev-down.ps1",
        ";",
        "docker/scripts/dev-up.ps1"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "📦 安装所有依赖",
      "dependsOrder": "parallel",
      "dependsOn": ["📦 安装后端依赖 (Python)", "📦 安装前端依赖"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "📦 安装后端依赖 (Python)",
      "type": "shell",
      "command": "uv",
      "args": ["sync"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "📦 安装前端依赖",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "options": {
        "cwd": "${workspaceFolder}/frontend",
        "shell": {
          "executable": "cmd.exe",
          "args": ["/c"]
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
